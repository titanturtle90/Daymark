// Firestore rules for Daymark. Each person can only read and write
// their own journal under users/{their uid}.
// Paste into Firebase console → Firestore Database → Rules, or deploy with
// `firebase deploy --only firestore:rules`.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
