// Storage rules for Daymark photos. Only the owner's Google account can
// read or write, only inside their own users/{uid} folder, and only images
// under 15 MB.
// Deploy with `firebase deploy --only storage`, or paste into
// Firebase console → Storage → Rules.
// To let someone else use it later, add their UID to owners().
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owners() { return ['uN289hLfIVPstE4rSR2ivBcpYt22']; }
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid
                          && request.auth.uid in owners();
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.auth.uid in owners()
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
